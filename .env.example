DATABASE_URL=postgresql://postgres:1234@localhost:5432/Juthoor
# Tests use a SEPARATE database (it is wiped on every run). Never point this at DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:1234@localhost:5432/juthoor_test
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_POOL_TIMEOUT=
JWT_SECRET=REPLACE_WITH_48_RANDOM_CHARS
ACCESS_TOKEN_MINUTES=720
RATE_LIMIT_ENABLED=1
TRUST_PROXY=0
DEMO_MODE=0
PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
STRIPE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@juthoor.jo
ENABLE_VECTOR_STORE=0
CHROMA_PERSIST_DIR=./chroma_store
